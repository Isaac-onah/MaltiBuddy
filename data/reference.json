    {
      "id": "vowels",
      "title": "Vowels",
      "blurb": "A, e, i, ie, o, and u. The article before them is l-.",
      "kind": "cards",
      "lead": "There are 6 vowels: a, e, i, ie, o, and u. Ie is one vowel. A word that starts with a vowel takes l-, not il-. The same l- is used before għ and h.",
      "items": [
        {
          "title": "a",
          "sound": "The article is l-.",
          "example": "art",
          "gloss": "a piece of land, or a floor",
          "note": "l-art. Also anġlu, an angel."
        },
        {
          "title": "e",
          "sound": "The article is l-.",
          "example": "envelop",
          "gloss": "an envelope",
          "note": "Also entratura, an entrance. The notes also give l-elf, the thousand."
        },
        {
          "title": "i",
          "sound": "The article is l-.",
          "example": "ittra",
          "gloss": "a letter",
          "note": "This is the single letter i. Also inka, an ink. l-ilsien is the tongue."
        },
        {
          "title": "ie",
          "sound": "One vowel. The article is l-.",
          "example": "ieqaf",
          "gloss": "stop",
          "note": "Written with two symbols, counted as one vowel. Also ieħor, another. l-iebes means hard."
        },
        {
          "title": "o",
          "sound": "The article is l-.",
          "example": "ors",
          "gloss": "a bear",
          "note": "Also ordni, an order. l-omm is the mother, and l-oħxon means fat."
        },
        {
          "title": "u",
          "sound": "The article is l-.",
          "example": "umbrella",
          "gloss": "an umbrella",
          "note": "Also umli, humble. l-uffiċju is the office."
        }
      ]
    },
